{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/edit_decisions",
  "title": "Edit Decisions",
  "description": "Canonical final-timeline edit contract consumed by video_compose and the Remotion Explainer. in_seconds/out_seconds are absolute timeline positions; source_in_seconds trims inside source media.",
  "type": "object",
  "required": [
    "version",
    "renderer_family",
    "render_runtime",
    "composition_mode"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "cuts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cut"
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/overlay"
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "word",
          "startMs",
          "endMs"
        ],
        "properties": {
          "word": {
            "type": "string"
          },
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "audio": {
      "$ref": "#/$defs/audio"
    },
    "subtitles": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "style": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "sentence",
                "word-by-word",
                "karaoke",
                "phrase"
              ]
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        },
        "source": {
          "type": "string"
        },
        "font": {
          "type": "string"
        },
        "font_size": {
          "type": "integer"
        },
        "color": {
          "type": "string"
        },
        "outline_color": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "position": {
          "type": "string",
          "enum": [
            "top-center",
            "bottom-center",
            "center"
          ]
        },
        "max_words_per_line": {
          "type": "integer",
          "minimum": 1
        },
        "language_code": {
          "type": "string",
          "minLength": 2
        },
        "locale": {
          "type": "string",
          "minLength": 2
        },
        "unicode_normalization": {
          "type": "string",
          "const": "NFC"
        },
        "layout_policy": {
          "type": "string",
          "enum": [
            "reserved-rail",
            "adaptive-regions"
          ]
        },
        "preferred_zone": {
          "type": "string",
          "enum": [
            "top",
            "bottom"
          ]
        },
        "fallback_zones": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "top",
              "bottom"
            ]
          },
          "uniqueItems": true
        },
        "safe_margin_px": {
          "type": "integer",
          "minimum": 24,
          "maximum": 240
        },
        "reserved_rail_height_px": {
          "type": "integer",
          "minimum": 120,
          "maximum": 420
        },
        "reserved_rail_height_ratio": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.3
        },
        "protected_regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/normalizedProtectedRegion"
          }
        },
        "visual_treatment": {
          "type": "string",
          "enum": [
            "integrated-field",
            "local-pill",
            "surface"
          ],
          "description": "Appearance of the caption container, independent from collision-safe layout geometry."
        },
        "full_width_background": {
          "type": "boolean",
          "description": "Whether caption styling draws a visible full-width backing surface."
        },
        "background_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Maximum opacity of any caption backing surface."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "language_code",
              "unicode_normalization",
              "layout_policy",
              "preferred_zone",
              "safe_margin_px",
              "protected_regions",
              "visual_treatment",
              "full_width_background"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              },
              "layout_policy": {
                "const": "reserved-rail"
              }
            },
            "required": [
              "enabled",
              "layout_policy"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "reserved_rail_height_px"
                ]
              },
              {
                "required": [
                  "reserved_rail_height_ratio"
                ]
              }
            ]
          }
        }
      ]
    },
    "music": {
      "type": "object",
      "description": "Deprecated top-level music configuration. Prefer audio.music.",
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "src": {
          "type": "string"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ducking": {
          "$ref": "#/$defs/ducking"
        },
        "fade_in_seconds": {
          "type": "number",
          "minimum": 0
        },
        "fade_out_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "transitions": {
      "type": "array",
      "description": "Deprecated global transition list. Prefer per-cut transition_in/transition_out.",
      "items": {
        "type": "object",
        "required": [
          "type",
          "at_seconds",
          "duration_seconds"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "at_seconds": {
            "type": "number",
            "minimum": 0
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "renderer_family": {
      "type": "string",
      "enum": [
        "explainer-data",
        "explainer-teacher",
        "cinematic-trailer",
        "documentary-montage",
        "product-reveal",
        "screen-demo",
        "presenter",
        "animation-first",
        "bespoke"
      ]
    },
    "render_runtime": {
      "type": "string",
      "enum": [
        "remotion",
        "hyperframes",
        "ffmpeg"
      ]
    },
    "composition_mode": {
      "type": "string",
      "enum": [
        "templated",
        "atelier"
      ]
    },
    "bespoke": {
      "type": "object",
      "required": [
        "art_direction",
        "scene_inventory"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "description": "Remotion Atelier entry file"
        },
        "composition_id": {
          "type": "string",
          "description": "Remotion Atelier composition ID"
        },
        "workspace_path": {
          "type": "string",
          "description": "Existing hand-authored HyperFrames workspace"
        },
        "index_path": {
          "type": "string",
          "description": "Optional HTML entry relative to workspace_path; defaults to index.html"
        },
        "art_direction": {
          "type": "string",
          "minLength": 1
        },
        "props_path": {
          "type": "string"
        },
        "public_dir": {
          "type": "string"
        },
        "scale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1.0
        },
        "crf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 51
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "scene_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "scene_id",
              "primary_subject",
              "signature_device_present"
            ],
            "properties": {
              "scene_id": {
                "type": "string"
              },
              "primary_subject": {
                "type": "string"
              },
              "signature_device_present": {
                "type": "boolean"
              },
              "representative_frame": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "delivery_promise": {
      "type": "object"
    },
    "slideshow_risk_score": {
      "type": "object",
      "properties": {
        "average": {
          "type": "number"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "strong",
            "acceptable",
            "revise",
            "fail"
          ]
        }
      },
      "additionalProperties": true
    },
    "total_duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "metadata": {
      "type": "object"
    },
    "video_category": {
      "type": "string",
      "enum": [
        "overview-video"
      ],
      "description": "Approved viewer-facing category copied from proposal and scene plan."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "composition_mode": {
            "const": "atelier"
          }
        },
        "required": [
          "composition_mode"
        ]
      },
      "then": {
        "required": [
          "bespoke"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "composition_mode": {
            "const": "atelier"
          },
          "render_runtime": {
            "const": "remotion"
          }
        },
        "required": [
          "composition_mode",
          "render_runtime"
        ]
      },
      "then": {
        "properties": {
          "bespoke": {
            "required": [
              "entry",
              "composition_id",
              "art_direction",
              "scene_inventory"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "composition_mode": {
            "const": "atelier"
          },
          "render_runtime": {
            "const": "hyperframes"
          }
        },
        "required": [
          "composition_mode",
          "render_runtime"
        ]
      },
      "then": {
        "properties": {
          "bespoke": {
            "required": [
              "workspace_path",
              "art_direction",
              "scene_inventory"
            ]
          }
        },
        "required": [
          "total_duration_seconds"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "composition_mode": {
            "const": "templated"
          }
        },
        "required": [
          "composition_mode"
        ]
      },
      "then": {
        "required": [
          "cuts"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "video_category": {
            "const": "overview-video"
          }
        },
        "required": [
          "video_category"
        ]
      },
      "then": {
        "required": [
          "subtitles"
        ],
        "properties": {
          "subtitles": {
            "allOf": [
              {
                "properties": {
                  "enabled": {
                    "const": true
                  },
                  "visual_treatment": {
                    "const": "integrated-field"
                  },
                  "full_width_background": {
                    "const": false
                  },
                  "background_opacity": {
                    "maximum": 0.18
                  }
                },
                "required": [
                  "enabled",
                  "visual_treatment",
                  "full_width_background"
                ]
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "cut": {
      "type": "object",
      "required": [
        "id",
        "source",
        "in_seconds",
        "out_seconds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "Source file path or asset-manifest ID. Use an empty string for component-only scenes."
        },
        "type": {
          "type": "string",
          "enum": [
            "talking_head",
            "broll",
            "video",
            "animation",
            "character_scene",
            "diagram",
            "text_card",
            "transition",
            "generated",
            "screen_recording",
            "hero_title",
            "stat_card",
            "bar_chart",
            "line_chart",
            "pie_chart",
            "kpi_grid",
            "comparison",
            "callout",
            "progress_bar",
            "anime_scene",
            "terminal_scene",
            "screenshot_scene"
          ]
        },
        "in_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Absolute start on the final timeline"
        },
        "out_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Absolute end on the final timeline"
        },
        "source_in_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Trim/seek offset inside source media"
        },
        "speed": {
          "type": "number",
          "minimum": 0.1,
          "default": 1.0
        },
        "layer": {
          "type": "string",
          "enum": [
            "primary",
            "overlay",
            "background"
          ],
          "default": "primary"
        },
        "text": {
          "type": "string"
        },
        "stat": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "heroSubtitle": {
          "type": "string"
        },
        "callout_type": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "tip",
            "quote"
          ]
        },
        "leftLabel": {
          "type": "string"
        },
        "rightLabel": {
          "type": "string"
        },
        "leftValue": {
          "type": "string"
        },
        "rightValue": {
          "type": "string"
        },
        "chartData": {
          "type": "array",
          "items": {}
        },
        "chartSeries": {
          "type": "array",
          "items": {}
        },
        "chartColors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chartAnimation": {
          "type": "string"
        },
        "donut": {
          "type": "boolean"
        },
        "centerLabel": {
          "type": "string"
        },
        "centerValue": {
          "type": "string"
        },
        "showGrid": {
          "type": "boolean"
        },
        "showValues": {
          "type": "boolean"
        },
        "showLegend": {
          "type": "boolean"
        },
        "showMarkers": {
          "type": "boolean"
        },
        "xLabel": {
          "type": "string"
        },
        "yLabel": {
          "type": "string"
        },
        "columns": {
          "type": "integer",
          "enum": [
            2,
            3,
            4
          ]
        },
        "progress": {
          "type": "number"
        },
        "progressLabel": {
          "type": "string"
        },
        "progressColor": {
          "type": "string"
        },
        "progressAnimation": {
          "type": "string"
        },
        "progressSegments": {
          "type": "array",
          "items": {}
        },
        "backgroundColor": {
          "type": "string"
        },
        "backgroundImage": {
          "type": "string"
        },
        "backgroundVideo": {
          "type": "string"
        },
        "backgroundVideoStart": {
          "type": "number",
          "minimum": 0
        },
        "backgroundOverlay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "color": {
          "type": "string"
        },
        "accentColor": {
          "type": "string"
        },
        "fontSize": {
          "type": "number",
          "minimum": 1
        },
        "animation": {
          "type": "string"
        },
        "transition_in": {
          "type": "string"
        },
        "transition_out": {
          "type": "string"
        },
        "transition_duration": {
          "type": "number",
          "minimum": 0
        },
        "transform": {
          "type": "object",
          "properties": {
            "scale": {
              "type": "number",
              "minimum": 0
            },
            "position": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "animation": {
              "type": "string"
            },
            "crop": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "particles": {
          "type": "string"
        },
        "particleColor": {
          "type": "string"
        },
        "particleCount": {
          "type": "integer",
          "minimum": 0
        },
        "particleIntensity": {
          "type": "number",
          "minimum": 0
        },
        "vignette": {
          "type": "boolean"
        },
        "lightingFrom": {
          "type": "string"
        },
        "lightingTo": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {}
        },
        "terminalTitle": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "screenshotSteps": {
          "type": "array",
          "items": {}
        },
        "screenshotSize": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "cursorStartAt": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "reason": {
          "type": "string"
        },
        "shot_language": {
          "type": "object"
        },
        "shot_intent": {
          "type": "string"
        },
        "narrative_role": {
          "type": "string"
        },
        "information_role": {
          "type": "string"
        },
        "hero_moment": {
          "type": "boolean"
        },
        "primary_subject": {
          "type": "string"
        },
        "visual_state_before": {
          "type": "string"
        },
        "visual_action": {
          "type": "string"
        },
        "visual_state_after": {
          "type": "string"
        },
        "motion_class": {
          "type": "string",
          "enum": [
            "source_motion",
            "generated_motion",
            "procedural_semantic_motion",
            "character_motion",
            "ui_interaction",
            "camera_only",
            "decorative_loop",
            "static_hold"
          ]
        },
        "semantic_purpose": {
          "type": "string"
        },
        "approved_hold_reason": {
          "type": "string",
          "minLength": 1,
          "description": "Explicit approval for an intentional non-semantic hold longer than 2.5 seconds. Valid only with motion_class=static_hold."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "motion_class": {
                "enum": [
                  "source_motion",
                  "generated_motion",
                  "procedural_semantic_motion",
                  "character_motion",
                  "ui_interaction"
                ]
              }
            },
            "required": [
              "motion_class"
            ]
          },
          "then": {
            "required": [
              "primary_subject",
              "visual_state_before",
              "visual_action",
              "visual_state_after",
              "semantic_purpose"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "text_card",
                  "hero_title",
                  "callout"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stat_card"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "stat"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "bar_chart",
                  "pie_chart",
                  "kpi_grid"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "chartData"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "line_chart"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "chartSeries"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "comparison"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "leftLabel",
              "leftValue",
              "rightLabel",
              "rightValue"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "progress_bar"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "progress"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "anime_scene"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "images"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "terminal_scene"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "steps"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "screenshot_scene"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "backgroundImage",
              "screenshotSteps"
            ]
          }
        },
        {
