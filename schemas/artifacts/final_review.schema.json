{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/final_review",
  "title": "Final Review",
  "description": "Structured self-review of the rendered output. The compose stage must produce this artifact to prove the agent inspected the actual rendered video before presenting it to the user. If status is 'revise' or 'fail', the agent must not present the video as complete.",
  "type": "object",
  "required": [
    "version",
    "output_path",
    "status",
    "checks"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "output_path": {
      "type": "string",
      "description": "Path to the rendered output file that was reviewed"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "revise",
        "fail"
      ],
      "description": "pass=ready to present, revise=fixable issues found, fail=critical problems"
    },
    "checks": {
      "type": "object",
      "required": [
        "technical_probe",
        "visual_spotcheck",
        "audio_spotcheck",
        "promise_preservation",
        "subtitle_check"
      ],
      "properties": {
        "technical_probe": {
          "type": "object",
          "description": "ffprobe validation of the output file",
          "properties": {
            "valid_container": {
              "type": "boolean"
            },
            "duration_seconds": {
              "type": "number"
            },
            "resolution": {
              "type": "string"
            },
            "fps": {
              "type": "number"
            },
            "has_audio": {
              "type": "boolean"
            },
            "codec": {
              "type": "string"
            },
            "file_size_bytes": {
              "type": "integer"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "visual_spotcheck": {
          "type": "object",
          "description": "Sample frames inspected from opening, middle, climax, ending",
          "properties": {
            "frames_sampled": {
              "type": "integer",
              "minimum": 0
            },
            "frame_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "scene_boundary_frames": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "timestamp_seconds",
                  "path"
                ],
                "properties": {
                  "timestamp_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "contact_sheet_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "sample_fps": {
              "type": "number",
              "minimum": 0
            },
            "motion_frames_analyzed": {
              "type": "integer",
              "minimum": 0
            },
            "motion_coverage_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "required_motion_coverage_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "mean_frame_difference": {
              "type": "number",
              "minimum": 0
            },
            "freeze_segments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "start_seconds",
                  "end_seconds",
                  "duration_seconds"
                ],
                "properties": {
                  "start_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "duration_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "approved": {
                    "type": "boolean"
                  },
                  "approved_hold_reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "repeated_layout_pairs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "first_seconds",
                  "second_seconds",
                  "hamming_distance"
                ],
                "properties": {
                  "first_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "second_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "hamming_distance": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "black_frames_detected": {
              "type": "boolean"
            },
            "broken_overlays": {
              "type": "boolean"
            },
            "missing_assets": {
              "type": "boolean"
            },
            "unreadable_text": {
              "type": "boolean"
            },
            "automated_text_collision_check": {
              "type": "boolean"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "audio_spotcheck": {
          "type": "object",
          "description": "Audio quality verification",
          "properties": {
            "narration_present": {
              "type": "boolean"
            },
            "music_present": {
              "type": "boolean"
            },
            "unexpected_silence": {
              "type": "boolean"
            },
            "clipping_detected": {
              "type": "boolean"
            },
            "mix_intelligible": {
              "type": "boolean"
            },
            "integrated_loudness_lufs": {
              "type": [
                "number",
                "null"
              ]
            },
            "true_peak_db": {
              "type": [
                "number",
                "null"
              ]
            },
            "loudness_range_lu": {
              "type": [
                "number",
                "null"
              ]
            },
            "ducking_expected": {
              "type": "boolean"
            },
            "ducking_configured": {
              "type": "boolean"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "promise_preservation": {
          "type": "object",
          "description": "Delivery promise and renderer governance checks",
          "properties": {
            "delivery_promise_honored": {
              "type": "boolean"
            },
            "renderer_family_used": {
              "type": "string",
              "description": "Creative grammar that actually ran"
            },
            "render_runtime_used": {
              "type": "string",
              "enum": [
                "remotion",
                "hyperframes",
                "ffmpeg"
              ],
              "description": "Technical runtime that actually executed the render. Must match the runtime locked at proposal unless a logged decision overrode it."
            },
            "runtime_swap_detected": {
              "type": "boolean",
              "description": "True if the runtime that ran differs from the runtime locked in proposal_packet. An unapproved swap is a contract violation."
            },
            "runtime_swap_check": {
              "type": "string",
              "description": "Human-readable status of the runtime-swap check: 'ok \u2014 \u2026', 'detected \u2014 \u2026', or 'skipped \u2014 \u2026'. When the check was skipped, the reviewer skill is responsible for cross-artifact comparison."
            },
            "motion_ratio_actual": {
              "type": "number"
            },
            "silent_downgrade_detected": {
              "type": "boolean"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "video_category_used": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "overview-video"
              ]
            },
            "category_contract_honored": {
              "type": "boolean"
            }
          }
        },
        "subtitle_check": {
          "type": "object",
          "description": "Subtitle/caption verification against source script",
          "properties": {
            "subtitles_expected": {
              "type": "boolean"
            },
            "subtitles_present": {
              "type": "boolean"
            },
            "coverage_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "render_mode": {
              "type": "string",
              "enum": [
                "subtitle_stream",
                "burned_in_file",
                "burned_in_caption_overlay"
              ]
            },
            "timing_drift_detected": {
              "type": "boolean"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "layout_policy_declared": {
              "type": "boolean"
            },
            "protected_regions_checked": {
              "type": "boolean"
            },
            "occlusion_free": {
              "type": "boolean"
            },
            "collision_count": {
              "type": "integer",
              "minimum": 0
            },
            "unicode_text_ok": {
              "type": "boolean"
            },
            "visual_treatment_declared": {
              "type": "boolean"
            },
            "caption_background_continuity": {
              "type": "boolean"
            },
            "full_width_caption_bar_detected": {
              "type": "boolean"
            }
          },
          "required": [
            "subtitles_expected",
            "subtitles_present",
            "layout_policy_declared",
            "protected_regions_checked",
            "occlusion_free",
            "collision_count",
            "unicode_text_ok",
            "issues",
            "visual_treatment_declared",
            "caption_background_continuity",
            "full_width_caption_bar_detected"
          ]
        },
        "transcript_comparison": {
          "type": "object",
          "description": "Optional: transcribe the output and compare to source script",
          "properties": {
            "transcript_matches_script": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "word_accuracy": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "transcript_source": {
              "type": "string",
              "enum": [
                "rendered_output",
                "caller_provided_fallback",
                "unavailable"
              ]
            },
            "transcript_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "script_word_count": {
              "type": "integer",
              "minimum": 0
            },
            "transcript_word_count": {
              "type": "integer",
              "minimum": 0
            },
            "spurious_punctuation_words": {
              "type": "array"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "atelier": {
          "type": "object",
          "description": "Atelier-only doctrine checks (populated when composition_mode='atelier'). Generated by tools/video/video_compose.py \u2192 _run_atelier_checks.",
          "properties": {
            "stock_reuse_detected": {
              "type": "boolean",
              "description": "TRUE if the bespoke project imports from the stock creative registry \u2014 fails the render."
            },
            "offending_imports": {
              "type": "array",
              "description": "Files + import paths that violated the doctrine.",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "import": {
                    "type": "string"
                  }
                }
              }
            },
            "art_direction_declared": {
              "type": "boolean"
            },
            "art_direction": {
              "type": [
                "string",
                "null"
              ]
            },
            "scene_inventory_count": {
              "type": "integer",
              "minimum": 0
            },
            "duplicate_primary_subjects": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "signature_device_scene_count": {
              "type": "integer",
              "minimum": 0
            },
            "scene_distinctness_failed": {
              "type": "boolean"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "semantic_visual_review": {
          "type": "object",
          "description": "Rendered multimodal design review and independent governance gate.",
          "additionalProperties": true,
          "properties": {
            "required": {
              "type": "boolean"
            },
            "present": {
              "type": "boolean"
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": "string"
            },
            "gate_valid": {
              "type": "boolean"
            },
            "human_approval_required": {
              "type": "boolean"
            },
            "human_approval_status": {
              "type": "string"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "issues_found": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All issues found across all checks, summarized for the user"
    },
    "recommended_action": {
      "type": "string",
      "enum": [
        "present_to_user",
        "re_render",
        "revise_edit",
        "revise_assets",
        "block",
        "re_author"
      ],
      "description": "What the agent should do next based on the review findings"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
