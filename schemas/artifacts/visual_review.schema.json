{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmontage.local/schemas/visual_review.schema.json",
  "title": "Rendered semantic visual review",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "video_path", "iteration", "review_mode", "reviewer", "evidence", "status", "summary", "dimensions", "findings", "must_fix", "keep", "confidence", "human_approval"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "video_path": {"type": "string"},
    "iteration": {"type": "integer", "minimum": 1, "maximum": 3},
    "review_mode": {"type": "string", "enum": ["single", "pairwise"]},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "transport", "human_replacement"],
      "properties": {
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "transport": {"type": "string"},
        "human_replacement": {"type": "boolean", "const": false}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_paths", "frame_metadata", "frame_count", "hook_window_reviewed"],
      "properties": {
        "frame_paths": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string"}},
        "frame_metadata": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "path", "label", "timestampSeconds", "sceneId"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "path": {"type": "string"},
              "label": {"type": "string"},
              "timestampSeconds": {"type": "number", "minimum": 0},
              "sceneId": {"type": "string"}
            }
          }
        },
        "frame_count": {"type": "integer", "minimum": 1, "maximum": 16},
        "hook_window_reviewed": {"type": "boolean"}
      }
    },
    "status": {"type": "string", "enum": ["pass", "revise", "fail"]},
    "summary": {"type": "string"},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook_0_3_seconds", "editorial_hierarchy", "primary_subject_scale", "ui_legibility", "label_readability", "dead_space_discipline", "frame_and_container_discipline", "semantic_motion_clarity", "caption_readability", "caption_rhythm", "evidence_story_alignment", "professional_finish"],
      "properties": {
        "hook_0_3_seconds": {"$ref": "#/$defs/score"},
        "editorial_hierarchy": {"$ref": "#/$defs/score"},
        "primary_subject_scale": {"$ref": "#/$defs/score"},
        "ui_legibility": {"$ref": "#/$defs/score"},
        "label_readability": {"$ref": "#/$defs/score"},
        "dead_space_discipline": {"$ref": "#/$defs/score"},
        "frame_and_container_discipline": {"$ref": "#/$defs/score"},
        "semantic_motion_clarity": {"$ref": "#/$defs/score"},
        "caption_readability": {"$ref": "#/$defs/score"},
        "caption_rhythm": {"$ref": "#/$defs/score"},
        "evidence_story_alignment": {"$ref": "#/$defs/score"},
        "professional_finish": {"$ref": "#/$defs/score"}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "frame_index", "timestamp_seconds", "scene_id", "category", "observation", "why_it_matters", "action"],
        "properties": {
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "frame_index": {"type": "integer", "minimum": 0},
          "timestamp_seconds": {"type": "number", "minimum": 0},
          "scene_id": {"type": "string"},
          "category": {"type": "string"},
          "observation": {"type": "string"},
          "why_it_matters": {"type": "string"},
          "action": {"type": "string"}
        }
      }
    },
    "must_fix": {"type": "array", "items": {"type": "string"}},
    "keep": {"type": "array", "items": {"type": "string"}},
    "comparison": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["winner", "reasons"],
          "properties": {
            "winner": {"type": "string", "enum": ["candidate_a", "candidate_b", "tie"]},
            "reasons": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "model": {"type": "string"},
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": {"type": "boolean", "const": true},
        "status": {"type": "string", "enum": ["pending", "approved", "rejected"]},
        "approved_by": {"type": "string"},
        "approved_at": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  },
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "reason"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 5},
        "reason": {"type": "string"}
      }
    }
  }
}
